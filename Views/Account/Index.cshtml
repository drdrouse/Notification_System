@model DataAccessLibrary.Models.Profile

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <div class="container">

        <div class="main-data">
            <div class="top-part">
                @*Аватарка пользователя*@
                @if (User.IsInRole("Admin"))
                {
                    <div class="avatar-container" id="photo">
                        <img src="/content/images/account/avatar.png" class="avatar" />
                    </div>
                }
                else
                {
                    <div class="avatar-container" id="photo">
                        <img src="/content/images/account/avatar-placeholder.png" alt="photo" class="avatar" />
                    </div>
                }
                <div class="person-data">
                    @*Плашка с данными*@
                    <div class="info-box">
                        @*ФИО*@
                        <p id="name">@Model.ProfileSurname @Model.ProfileName @Model.ProfilePatronymic</p>
                        <hr />
                        @*Табльный номер*@
                        <div class="text-container">
                            <span class="text-1">Табельный номер:</span>
                            <span class="text-2" id="tabnum">@Model.ProfileTabNum</span>
                        </div>
                    </div>
                    @*Место работы*@
                    <div class="datadrop">
                        <button onclick="myFunctionPosition()" class="add-item">
                            <div class="button-text">Место работы</div>
                        </button>
                        <div id="positionDrop" class="datadrop-content">
                            <div class="item">
                                @Model.OrganizationUnits?.FirstOrDefault()?.Subdivision?.SubdivisionPath
                                @Model.OrganizationUnits?.FirstOrDefault()?.Post?.PostName
                            </div>
                        </div>
                    </div>
                    @*Список emails*@
                    <div class="datadrop">
                        <button onclick="myFunctionEmail()" class="add-item">
                            <div class="button-text">Почта</div>
                        </button>
                        <div id="emailsDrop" class="datadrop-content">
                            @foreach (var mail in Model.Mail)
                            {
                                <div class="item"><div style="font-weight: bold">@mail.TypeMail.TypeMailName почта:</div>@mail.MailsName</div>
                            }
                        </div>
                    </div>

                    @*Список телефонов*@
                    <div class="datadrop">
                        <button onclick="myFunctionPhone()" class="add-item">
                            <div class="button-text">Телефон</div>
                        </button>
                        <div id="phonesDrop" class="datadrop-content">
                            @foreach (var phone in Model.Phones)
                            {
                                <div class="item"><div style="font-weight: bold">@phone.TypePhone.TypePhoneName телефон:</div>@phone.PhonesNum</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            @*Нижняя часть информационной области*@
            <div class="bottom-part">
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Пн</th>
                            <th>Вт</th>
                            <th>Ср</th>
                            <th>Чт</th>
                            <th>Пт</th>
                            <th>Сб</th>
                            <th>Вс</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Генерация календаря на текущий месяц -->
                        @{
                            var now = DateTime.Now;
                            var year = now.Year;
                            var month = now.Month;
                            var daysInMonth = DateTime.DaysInMonth(year, month);
                            var firstDay = new DateTime(year, month, 1);
                            var startingDay = (int)firstDay.DayOfWeek;
                            startingDay = startingDay == 0 ? 7 : startingDay; // Воскресенье = 7
                            
                            var dayCounter = 1;
                            var isWorkDay = true; // Начинаем с рабочего дня (график 2/2)
                            
                            for (int i = 0; i < 6; i++)
                            {
                                if (dayCounter > daysInMonth) break;
                                
                                <tr>
                                    <td>Неделя @(i+1)</td>
                                    @for (int j = 1; j <= 7; j++)
                                    {
                                        if ((i == 0 && j < startingDay) || dayCounter > daysInMonth)
                                        {
                                            <td></td>
                                        }
                                        else
                                        {
                                            var currentDate = new DateTime(year, month, dayCounter);
                                            var isToday = currentDate.Date == DateTime.Now.Date;
                                            
                                            <td class="@(isToday ? "current-day" : "") @(isWorkDay ? "work-day" : "day-off")">
                                                @dayCounter<br>
                                                @(isWorkDay ? "12ч" : "Вых")
                                            </td>
                                            
                                            // Меняем статус дня для графика 2/2
                                            if (j % 2 == 0) isWorkDay = !isWorkDay;
                                            dayCounter++;
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    <script src="~/js/account_emaildrop.js"></script>
    <script src="~/js/account_phonedrop.js"></script>
    <script src="~/js/account_positiondrop.js"></script>
    <script src="~/js/change_style.js"></script>
</body>
</html>