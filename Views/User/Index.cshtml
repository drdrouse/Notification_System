@model IEnumerable<DataAccessLibrary.Models.Account>
@{
    var statuses = (List<DataAccessLibrary.Models.AccountStatus>)ViewBag.Statuses;
    var roles = (List<DataAccessLibrary.Models.Role>)ViewBag.Roles;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/log_table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role_form.css" asp-append-version="true" />
</head>
<body>
    <div class="container">

        <div class="main-data">
            <div class="user-setting">

                <div class="status-list">
                    <label for="status">Статус пользователя:</label>
                    <select id="status" name="status" form="statusForm">
                        <option value="@Model.FirstOrDefault().AccountStatus.AccountStatusName">@Model.FirstOrDefault().AccountStatus.AccountStatusName</option>
                        
                        @if ((Model.FirstOrDefault().RoleAssignments.Select(ra => ra.Role.RoleName).ToList().Contains("Admin")
                        && !User.IsInRole("Admin")) || (Guid.Parse(User.Identity.Name) == Model.FirstOrDefault().AccountId))
                        { }
                        else
                        {
                            @foreach (var status in statuses)
                            {
                                @if (status.AccountStatusName != Model.FirstOrDefault().AccountStatus.AccountStatusName)
                            {
                                <option value="@status.AccountStatusName">@status.AccountStatusName</option>

                            }
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="top-part">
                @*Аватарка пользователя*@
                <div class="avatar-container">
                    <img src="/content/images/account/avatar-placeholder.png" id="photo" class="avatar">
                </div>
                <div class="person-data">
                    @*Плашка с данными*@
                    <div class="info-box">
                        @*ФИО*@
                        <p id="name">@Model.FirstOrDefault().Profile.ProfileSurname @Model.FirstOrDefault().Profile.ProfileName @Model.FirstOrDefault().Profile.ProfilePatronymic</p>
                        <hr />
                        @*Табльный номер*@
                        <div class="text-container">
                            <span class="text-1" id="tabnum">Табельный номер: @Model.FirstOrDefault().Profile.ProfileTabNum</span>
                        </div>
                        <hr />
                        @*Место работы*@
                        <div class="text-container">
                            <span class="text-1">Место работы:</span>
                            <span class="text-2" id="tabnum">ПАО СБЕРБАНК/ДВ/</span>
                        </div>
                    </div>
                    @*Список emails*@
                    <div class="datadrop">
                        <button onclick="myFunctionEmail()" class="add-item">
                            <div class="button-text">Почта</div>
                        </button>
                        <div id="emailsDrop" class="datadrop-content">
                            @foreach (var mail in Model.FirstOrDefault().Profile.Mail)
                            {
                                <div class="item"><div style="font-weight: bold">@mail.TypeMail.TypeMailName почта:</div>@mail.MailsName</div>
                            }
                        </div>
                    </div>
                    @*Список телефонов*@
                    <div class="datadrop">
                        <button onclick="myFunctionPhone()" class="add-item">
                            <div class="button-text">Телефон</div>
                        </button>
                        <div id="phonesDrop" class="datadrop-content">
                            @foreach (var phone in Model.FirstOrDefault().Profile.Phones)
                            {
                                <div class="item"><div style="font-weight: bold">@phone.TypePhone.TypePhoneName телефон:</div>@phone.PhonesNum</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="role">
                <h4>Роли пользователя</h4>
                @if (!(Guid.Parse(User.Identity.Name) == Model.FirstOrDefault().AccountId))
                {
                    @if (!Model.FirstOrDefault().RoleAssignments.Select(ra => ra.Role.RoleName).ToList().Contains("Admin"))
                    {

                        <button id="add_role"><p>Добавить</p></button>
                    }
                }

            </div>
            @foreach (var role in Model.FirstOrDefault().RoleAssignments)
            {
                <div class="user_roles" id="@role.Role.RoleName">

                    <p class="p_role">@role.Role.RoleName</p>
                    @if (Guid.Parse(User.Identity.Name) != Model.FirstOrDefault().AccountId)
                    {
                        @if (role.Role.RoleName == "Admin" && User.IsInRole("Admin"))
                        {
                            <a onclick="location.href = '@Url.Action("RemoveRole", "User", new { name = @role.Role.RoleName, tabnum = @Model.FirstOrDefault().Profile.ProfileTabNum })'" id="@role.Role.RoleName" class="button_role">X</a>
                        }
                        @if (role.Role.RoleName == "Admin" && !User.IsInRole("Admin"))
                        {

                        }
                        @if (role.Role.RoleName != "Admin")
                        {
                            <a onclick="location.href = '@Url.Action("RemoveRole", "User", new { name = @role.Role.RoleName, tabnum = @Model.FirstOrDefault().Profile.ProfileTabNum })'" id="@role.Role.RoleName" class="button_role">X</a>
                        }
                    }
                </div>
            }
            <table border="0" class="user_table">
                <thead>
                    <tr>
                        <th class="first-column">Табельный номер</th>
                        <th class="second-column">Событие</th>
                        <th class="third-column">Дата</th>
                        <th class="fourth-column">Описание</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.FirstOrDefault().Profile.Logs.OrderBy(log => log.LogDateTime))
                    {
                        <tr>
                            <td class="first-column">@Model.FirstOrDefault().Profile.ProfileTabNum</td>
                            <td class="second-column">@log.EventCode.EventCodeName</td>
                            <td class="third-column">@log.LogDateTime</td>
                            <td class="fourth-column">@log.LogDeccription</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="end-button">
                <a class="back_button" type="submit" asp-controller="UserCreate" asp-action="Index">Назад</a>
                <form id="statusForm" class="back_button_form" method="post" asp-controller="User" asp-action="ChangeStatus">
                    <button class="back_button">Сохранить</button>
                </form>
            </div>
            <input type="hidden" name="tabnummner" value="@Model.FirstOrDefault().Profile.ProfileTabNum" form="statusForm"/>
        </div>
        @*Форма добавления новой роли*@
        <div id="modalForm" class="modal">
            <div class="modal-content">
                <a href="@Url.Action("ClearSession", "User",  new {tabnum = Model.FirstOrDefault().Profile.ProfileTabNum})" id="closeFormButton" class="close">&times;</a>
                <h2>Форма добавления новой роли</h2>
                <form class="checkbox-group" method="post" asp-controller="User" asp-action="AddNewRole">

                    @foreach (var role in roles)
                    {
                        @if (!Model.FirstOrDefault().RoleAssignments.Select(ra => ra.Role.RoleName).ToList().Contains(role.RoleName))
                        {
                            @if (role.RoleName == "Admin" && !User.IsInRole("Admin"))
                            {
                                continue;

                            }
                            else
                            {
                                <label class="role_chbo">
                                    <input type="checkbox" name="@role.RoleName" value="true"> @role.RoleName
                                </label>
                            }

                        }
                    }
                    <input type="hidden" name="tabNum" value="@Model.FirstOrDefault().Profile.ProfileTabNum" />
                    @* Кнопка добавление новых полей *@
                    <button class="save_button_role" id="addRole">Сохранить</button>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/account_emaildrop.js"></script>
    <script src="~/js/account_phonedrop.js"></script>
    <script src="~/js/open_role_form.js"></script>
    <script src="~/js/zeroing_checkbox.js"></script>
</body>
</html>
