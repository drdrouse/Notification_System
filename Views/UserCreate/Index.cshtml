@model IEnumerable<DataAccessLibrary.Models.Account>
@{
    var posts = (List<DataAccessLibrary.Models.Post>)ViewBag.Posts;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/users_show.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user_create_form.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="main-data">
            <div class="head-user">
                <h1>Пользователи</h1>
                <button id="add_user"><p>Добавить нового пользователя</p></button>
            </div>
            <hr />
            <table border="0" class="user_table">
                <tr>
                    <th class="first-column">Табельный номер</th>
                    <th class="second-column">ФИО</th>
                    <th class="third-column">Телефон</th>
                    <th class="fourth-column">Email</th>
                    <th class="fifth-column">Роль</th>
                    <th class="sixth-column">Статус</th>
                </tr>
                @foreach (var account in Model)
                {
                    <tr>
                        <th class="first-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">@account.Profile.ProfileTabNum</th>
                        <th class="second-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">@account.Profile.ProfileSurname @account.Profile.ProfileName @account.Profile.ProfilePatronymic</th>
                        <th class="third-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">@account.Profile.Phones.Where(ph => ph.PhonesIsPriority == true).FirstOrDefault()?.PhonesNum</th>
                        <th class="fourth-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">@account.Profile.Mail.Where(m => m.TypeMail.TypeMailName == "Корпоративная").FirstOrDefault()?.MailsName</th>
                        <th class="fifth-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">
                            @foreach (var role in account.RoleAssignments.ToList())
                            {
                                @role.Role.RoleName
                                <br />
                            }
                        </th>
                        <th class="sixth-column" onclick="location.href = '@Url.Action("Index", "User",  new { tabnum = account.Profile.ProfileTabNum })'">@account.AccountStatus.AccountStatusName</th>
                    </tr>
                }
            </table>
        </div>
        @*Форма добавления нового пользовтеля*@
    <div id="modalForm" class="modal">
        <div class="modal-content">
            <a href="@Url.Action("ClearSession", "UserCreate")" id="closeFormButton" class="close">&times;</a>
            <h2>Форма добавления нового пользователя</h2>
            <form method="post" asp-controller="UserCreate" asp-action="CreateUser">
                <!-- Блок персональных данных -->
                <div class="form-block">
                    <h3>Персональные данные</h3>
                    <label for="Surname">Фамилия:</label>
                    <input type="text" id="Surname" name="Surname" required
                           class="@Context.Session.GetString("SurnameValid")">

                    <label for="Name">Имя:</label>
                    <input type="text" id="Name" name="Name" required
                           class="@Context.Session.GetString("NameValid")">

                    <label for="Patronymic">Отчество:</label>
                    <input type="text" id="Patronymic" name="Patronymic" required
                           class="@Context.Session.GetString("PatronymicValid")">

                    <label for="CorporatePhone">Корпоративный телефон:</label>
                    <input type="tel" id="CorporatePhone" name="CorporatePhone"
                           class="@Context.Session.GetString("CorporatePhoneValid")">

                    <label for="CorporateEmail">Корпоративная почта:</label>
                    <input type="email" id="CorporateEmail" name="CorporateEmail"
                           class="@Context.Session.GetString("CorporateEmailValid")">
                </div>

                <!-- Блок корпоративной информации -->
                <div class="form-block">
                    <h3>Корпоративная информация</h3>
                    <label for="EmployeeNumber">Табельный номер:</label>
                    <input type="number" id="EmployeeNumber" name="EmployeeNumber" required
                           pattern="\d{7}" title="Введите табельный номер"
                           class="@Context.Session.GetString("EmployeeNumberValid")">

                    <label for="Position">Должность:</label>
                    <select id="Position" name="Position" required
                            class="@Context.Session.GetString("PositionValid")">
                        <option value="">-- Выберите должность --</option>
                        @foreach (var post in posts)
                        {
                            <option value="@post.PostName">@post.PostName</option>
                        }
                    </select>
                     </select>
                </div>

                <!-- Выпадающий список ролей -->
                <div class="form-block">
                    <h3>Роль пользователя</h3>
                    <label for="Role">Роль:</label>
                    <select id="Role" name="Role" required
                            class="@Context.Session.GetString("RoleValid")">
                        <option value="">-- Выберите роль --</option>
                        @foreach (var role in Model.SelectMany(p => p.RoleAssignments)
                      .Select(ra => ra.Role)
                      .Distinct())
                        {
                            @if (role.RoleName == "Admin" && User.IsInRole("Admin"))
                            {
                                <option value="@role.RoleName">@role.RoleName</option>
                            }
                            @if (role.RoleName == "Admin" && !User.IsInRole("Admin"))
                            {

                            }
                            @if (role.RoleName != "Admin")
                            {
                                <option value="@role.RoleName">@role.RoleName</option>
                            }
                            
                        }
                    </select>
                </div>

                <div id="messageArea" class="alert @Context.Session.GetString("MessageType")">
                    <pre>@Context.Session.GetString("Message")</pre>
                </div>

                <button class="newUser_button" id="addUser">Сохранить</button>
            </form>
        </div>
    </div>
    </div>
    @if (Context.Session.GetString("OpenModal") == "true")
    {
        <script src="~/js/open_change_password_form.js"></script>
    }
    <script src="~/js/open_new_user_form.js"></script>
    <script src="~/js/add_input_email.js"></script>
    <script src="~/js/add_input_phone.js"></script>
</body>
</html>