@model IEnumerable<DataAccessLibrary.Models.ServiceName>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/messenger.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/create_services.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="main-data">
            <h1>Сервисы</h1>
            <hr />
            <div class="active">
                <h4>Активные сервисы</h4>
                <button id="create_services"><p>Добавить</p></button>
            </div>
            <hr />
            @for (int check = 0; check < 2; check++)
            {
                <div class="messenger-button">
                    <button class="messenger-menu" data-target="@check"><p>Здесь будет название</p> </button>
                </div>
                <div id="@check" class="messanger-data-hidden">Скрытая область 1</div>
            }
            <hr style="margin-top:2%" />
            <div class="active">
                <h4>Заблокированные сервисы</h4>
            </div>
            <hr />
        </div>

    </div>
    @*Форма создания нового сервиса*@
    <div id="modalForm" class="modal">
        <div class="modal-content">
            <a href="@Url.Action("ClearSession", "MessengerCreate")" id="closeFormButton" class="close">&times;</a>
            <h2>Форма добавления нового сервиса</h2>
            <form method="post" asp-controller="MessengerCreate" asp-action="CreateService">
                <label for="service_name">Сервис отправки:</label>
                <select id="service_name" name="serviceName" required onchange="loadServiceFields()">
                    <option hidden>Выберите сервис</option>
                    @foreach (var service in Model)
                    {
                        <option value="@service.ServiceNameName">@service.ServiceNameName</option>
                    }
                </select>

                <label for="service_displayname">Полное наименование:</label>
                <input type="text" id="service_displayname" name="dispalyName" required>

                @*<label for="service_link">Ссылка на сервис:</label>
        <input type="text" id="service_link" name="link" required>*@

                @*Контейнер для полей с настройками*@
                <div id="fieldsContainer" class="service-fields-container">
                    <!-- Поля будут загружаться автоматически -->
                </div>
                <div id="messageArea" class="alert @Context.Session.GetString("Error")">
                    <pre>@Context.Session.GetString("Message")</pre>
                </div>
                @*Контейнер с кнопками*@
                <div class="buttons">
                    <button type="submit" class="btn btn-success">Сохранить</button>
                </div>
            </form>
        </div>
    </div>

    @if (Context.Session.GetString("OpenModal") == "true")
    {
        <script src="~/js/service_create_form.js"></script>
    }
    <script src="~/js/messenger.js"></script>
    <script src="~/js/open_create_service_form.js"></script>
    <script src="~/js/selected_inputs.js"></script>
</body>
</html>