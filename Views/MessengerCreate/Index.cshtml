@using static DataHelper.DictToString
@model IEnumerable<DataAccessLibrary.Models.Service>
@{
    var servicename = (List<DataAccessLibrary.Models.ServiceName>)ViewBag.ServiceName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/messenger.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/create_services.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="main-data">
            <h1>Сервисы</h1>
            <hr />
            <div class="active">
                <h4>Активные сервисы</h4>
                <button id="create_services"><p>Добавить</p></button>
            </div>
            <hr />
            @foreach (var service in Model)
            {
                @if (!service.ServiceIsBlocked)
                {
                    <div class="messenger-button">
                        <!-- Добавляем квадрат с иконкой перед кнопкой -->
                        @if (service.ServiseIsDisable)
                        {
                            <div class="service-icon" id="disable">
                                <img src="~/content/images/account/disable.png" alt="disable">
                            </div>
                        }
                        @if (!service.ServiseIsDisable)
                        {
                            <div class="service-icon" id="undisable">
                                <img src="~/content/images/account/undisable.png" alt="undisable">
                            </div>
                        }
                        <!-- Само поле (кнопка) -->
                    <button class="messenger-menu" onclick="toggleHiddenArea('@service.ServiceDisplayName')">
                        <p>@service.ServiceDisplayName</p>
                    </button>
                    </div>
                    <div class="messanger-data-hidden" id="@service.ServiceDisplayName" style="display: none;">
                        <div class="hidden-content">
                            <p>Создатель: @service.Account.Profile.ProfileSurname @service.Account.Profile.ProfileName @service.Account.Profile.ProfilePatronymic</p>
                            <hr />
                            <p>Тип сервиса: @service.ServiceName.ServiceNameName</p>
                            <hr />
                            <p>Дата создания: @service.ServiceRegDate</p>
                            <hr />
                            @if (!service.ServiseIsDisable)
                            {
                                <p>Состояние: Активен</p>
                            }
                            @if (service.ServiseIsDisable)
                            {
                                <p>Состояние: Отключён</p>
                            }
                            <hr />
                            @{
                                var setting_dict = DataHelper.DictToString.ReturnString(service.ServiceSettings);
                            }
                            @foreach (var settings in setting_dict)
                            {
                                 @if (settings.Key != "Password")
                                 {
                                    <p>@settings.Key: @settings.Value</p>
                                 }
                            }
                            <hr />
                            <div class="hidden-buttons">
                                @if (service.Account.AccountId == Guid.Parse(User.Identity.Name))
                                {
                                    <form method="post" asp-controller="MessengerCreate" asp-action="SendTestEmail">
                                        <input type="hidden" name="serviceID" value="@service.ServiceId" />
                                        <button type="submit" class="flat-btn">Отправить тестовое письмо</button>
                                    </form>                                
                                    <form method="post" asp-controller="MessengerCreate" asp-action="StartStopSend">
                                        <input type="hidden" name="serviceID" value="@service.ServiceId" />
                                        <button type="submit" class="flat-btn">Запустить/Остановить</button>
                                    </form>
                                }
                                <form method="post" asp-controller="MessengerCreate" asp-action="BlockedService">
                                    <input type="hidden" name="serviceID" value="@service.ServiceId" />
                                    <button type="submit" class="flat-btn">Заблокировать</button>
                                </form>
                               
                            </div>
                        </div>
                    </div>
                }
            }
            <hr style="margin-top:2%" />
            <div class="active">
                <h4>Заблокированные сервисы</h4>
            </div>
            <hr />
            @foreach (var service in Model)
            {
                @if (service.ServiceIsBlocked)
                {
                    <div class="messenger-button">
                        <button class="messenger-menu" onclick="toggleHiddenArea('@service.ServiceDisplayName')">
                            <p>@service.ServiceDisplayName</p>
                        </button>
                    </div>
                    <div class="messanger-data-hidden" id="@service.ServiceDisplayName" style="display: none;">
                        <div class="hidden-content">
                            <p>Создатель: @service.Account.Profile.ProfileSurname @service.Account.Profile.ProfileName @service.Account.Profile.ProfilePatronymic</p>
                            <hr />
                            <p>Тип сервиса: @service.ServiceName.ServiceNameName</p>
                            <hr />
                            <p>Дата создания: @service.ServiceRegDate</p>
                            <hr />
                            @if (!service.ServiseIsDisable)
                            {
                                <p>Состояние: Активен</p>
                            }
                            @if (service.ServiseIsDisable)
                            {
                                <p>Состояние: Отключён</p>
                            }
                            <hr />
                            @{
                                var setting_dict = DataHelper.DictToString.ReturnString(service.ServiceSettings);
                            }
                            @foreach (var settings in setting_dict)
                            {
                                <p>@settings.Key: @settings.Value</p>
                            }
                            <hr />
                            <div class="hidden-buttons">
                                <form method="post" asp-controller="MessengerCreate" asp-action="UnBlockedService">
                                    <input type="hidden" name="serviceID" value="@service.ServiceId" />
                                    <button type="submit" class="flat-btn">Разблокировать</button>
                                </form>
                                <form method="post" asp-controller="MessengerCreate" asp-action="UnBlockedService">
                                    <input type="hidden" name="serviceID" value="@service.ServiceId" />
                                    <button type="submit" class="flat-btn">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    @*Форма создания нового сервиса*@
    <div id="modalForm" class="modal">
        <div class="modal-content">
            <a href="@Url.Action("ClearSession", "MessengerCreate")" id="closeFormButton" class="close">&times;</a>
            <h2>Форма добавления нового сервиса</h2>
            <form method="post" asp-controller="MessengerCreate" asp-action="CreateService">
                <label for="service_name">Сервис отправки:</label>
                <select id="service_name" name="serviceName" required onchange="loadServiceFields()">
                    <option hidden>Выберите сервис</option>
                    @foreach (var service in servicename)
                    {
                        <option value="@service.ServiceNameName">@service.ServiceNameName</option>
                    }
                </select>

                <label for="service_displayname">Полное наименование:</label>
                <input type="text" id="service_displayname" name="dispalyName" required>


                @*Контейнер для полей с настройками*@
                <div id="fieldsContainer" class="service-fields-container">
                    <!-- Поля будут загружаться автоматически -->
                </div>
                <div id="messageArea" class="alert @Context.Session.GetString("Error")">
                    <pre>@Context.Session.GetString("Message")</pre>
                </div>
                @*Контейнер с кнопками*@
                <div class="buttons">
                    <button type="submit" class="btn btn-success">Сохранить</button>
                </div>
            </form>
        </div>
    </div>

    @if (Context.Session.GetString("OpenModal") == "true")
    {
        <script src="~/js/service_create_form.js"></script>
    }
    <script src="~/js/messenger.js"></script>
    <script src="~/js/open_create_service_form.js"></script>
    <script src="~/js/selected_inputs.js"></script>
    <script src="~/js/open_data.js"></script>
</body>
</html>